{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@ratiojs/bridge": ["../../src/index.ts"],
      "@ratiojs/bridge/*": ["../../src/*/index.ts"]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "exclude": ["node_modules"]
}
